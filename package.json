{
  "name": "instant-elements",
  "version": "1.5.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "A UI harness for coding agents — describe it, an agent builds it, the gallery shows it, every change is recorded.",
  "keywords": [
    "ui",
    "instant",
    "elements",
    "components",
    "interface",
    "design-system",
    "design-tokens",
    "gallery",
    "claude-code",
    "coding-agent",
    "ai"
  ],
  "license": "MIT",
  "author": "kh1012",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kh1012/instant-elements.git"
  },
  "homepage": "https://github.com/kh1012/instant-elements#readme",
  "bugs": {
    "url": "https://github.com/kh1012/instant-elements/issues"
  },
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "ie": "./dist/cli.js",
    "instant-elements": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./theme.css": "./styles/theme.css",
    "./styles/*": "./styles/*",
    "./package.json": "./package.json",
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js"
    }
  },
  "files": [
    "dist",
    "styles",
    "gallery",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p gallery/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jiti": "^2.7.0",
    "vite": "^8.1.5"
  }
}
