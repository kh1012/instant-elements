{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // 계약(schema.ts)만 가리킨다 — 레지스트리 배럴은 node:fs 를 끌어와 브라우저 설정에서 검사할 수 없다.
    "paths": {
      "instant-elements/registry": ["../src/registry/schema.ts"],
      "instant-elements/page": ["../src/page/schema.ts"]
    }
  },
  "include": ["src"]
}
